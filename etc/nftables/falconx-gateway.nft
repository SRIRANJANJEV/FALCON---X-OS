#!/usr/sbin/nft -f
# FALCON-X nftables Firewall — GATEWAY MODE
# Appliance acts as network gateway/firewall
# IP forwarding enabled, NAT for LAN clients

flush ruleset

# ── Variables ──────────────────────────────────────────────────────
define FALCONX_LAN_IF = "eth0"
define FALCONX_WAN_IF = "eth1"
define FALCONX_LAN_NET = "192.168.1.0/24"

# ── Rate limiting sets ────────────────────────────────────────────
set ssh_ratelimit {
    type ipv4_addr
    flags dynamic,timeout
    timeout 60s
}

set syn_flood {
    type ipv4_addr
    flags dynamic,timeout
    timeout 10s
}

# ── Table: filter ─────────────────────────────────────────────────
table inet falconx_filter {

    # ── Input chain (traffic TO the appliance) ────────────────────
    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop

        iif "lo" accept

        # ICMP
        ip protocol icmp icmp type echo-request limit rate 5/second accept
        ip protocol icmp icmp type echo-reply accept
        ip protocol icmp icmp type destination-unreachable accept
        ip protocol icmp icmp type time-exceeded accept

        # SSH — from LAN only, rate limited
        iif $FALCONX_LAN_IF tcp dport 22 ct state new add @ssh_ratelimit { ip saddr limit rate 3/minute } accept
        iif $FALCONX_LAN_IF tcp dport 22 drop

        # Dashboard — from LAN only
        iif $FALCONX_LAN_IF tcp dport 8443 accept

        # FALCON-X internal — localhost only
        iif "lo" tcp dport { 9100 } accept

        # Log and drop
        limit rate 5/minute log prefix "[FALCONX-GW-DROP] " level warn
        drop
    }

    # ── Forward chain (traffic THROUGH the appliance) ─────────────
    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop

        # LAN → WAN (outbound from LAN clients)
        iif $FALCONX_LAN_IF oif $FALCONX_WAN_IF accept

        # WAN → LAN (only established/related — already handled above)

        # Block inter-VLAN if multiple LAN interfaces
        # iif $FALCONX_LAN_IF oif $FALCONX_LAN_IF drop

        # Log and drop
        limit rate 5/minute log prefix "[FALCONX-FWD-DROP] " level warn
        drop
    }

    # ── Output chain (traffic FROM the appliance) ─────────────────
    chain output {
        type filter hook output priority filter; policy accept;

        oif "lo" accept
        ct state established,related accept

        # DNS
        udp dport 53 accept
        tcp dport 53 accept

        # NTP
        udp dport 123 accept

        # HTTPS/HTTP (updates)
        tcp dport { 80, 443 } accept

        # ICMP outbound
        ip protocol icmp accept
    }
}

# ── NAT table ─────────────────────────────────────────────────────
table ip falconx_nat {

    # Masquerade LAN traffic going to WAN
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oif $FALCONX_WAN_IF ip saddr $FALCONX_LAN_NET masquerade
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
    }
}

# ── Enable IP forwarding (gateway mode only) ──────────────────────
# Applied by the firewall manager script, not here directly.
# sysctl -w net.ipv4.ip_forward=1
