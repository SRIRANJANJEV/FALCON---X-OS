#!/usr/sbin/nft -f
# FALCON-X nftables Firewall — MONITOR MODE
# Default mode: appliance monitors network traffic only
# No IP forwarding, no gateway functionality

flush ruleset

# ── Variables ──────────────────────────────────────────────────────
define FALCONX_NET = "192.168.0.0/16"
define FALCONX_WAN_IF = "eth0"
define FALCONX_LAN_IF = "eth0"

# ── Rate limiting sets ────────────────────────────────────────────
set ssh_ratelimit {
    type ipv4_addr
    flags dynamic,timeout
    timeout 60s
}

set http_ratelimit {
    type ipv4_addr
    flags dynamic,timeout
    timeout 60s
}

# ── Blacklisted hosts ─────────────────────────────────────────────
set blocked_hosts {
    type ipv4_addr
    flags interval
    elements = {
        169.254.0.0/16,   # link-local
        224.0.0.0/4       # multicast (except specifics)
    }
}

# ── Table: filter ─────────────────────────────────────────────────
table inet falconx_filter {

    # ── Input chain ───────────────────────────────────────────────
    chain input {
        type filter hook input priority filter; policy drop;

        # Allow established/related
        ct state established,related accept

        # Drop invalid
        ct state invalid drop

        # Loopback
        iif "lo" accept

        # Drop blocked hosts
        ip saddr @blocked_hosts drop

        # ICMP: allow echo-request with rate limit
        ip protocol icmp icmp type echo-request limit rate 5/second accept
        ip protocol icmp icmp type echo-reply accept
        ip protocol icmp icmp type destination-unreachable accept
        ip protocol icmp icmp type time-exceeded accept

        # ICMPv6
        ip6 nexthdr icmpv6 icmpv6 type echo-request limit rate 5/second accept
        ip6 nexthdr icmpv6 icmpv6 type { echo-reply, destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept

        # SSH — rate limited
        tcp dport 22 ct state new add @ssh_ratelimit { ip saddr limit rate 3/minute } accept
        tcp dport 22 drop

        # FALCON-X Dashboard (external)
        tcp dport 8443 accept

        # FALCON-X internal services (localhost only)
        iif "lo" tcp dport { 9100 } accept

        # Log and drop everything else
        limit rate 5/minute log prefix "[FALCONX-DROP] " level warn
        drop
    }

    # ── Output chain ──────────────────────────────────────────────
    chain output {
        type filter hook output priority filter; policy accept;

        # Allow loopback
        oif "lo" accept

        # Allow established
        ct state established,related accept

        # Allow DNS
        udp dport 53 accept
        tcp dport 53 accept

        # Allow NTP
        udp dport 123 accept

        # Allow HTTPS (for updates, repo access)
        tcp dport 443 accept

        # Allow HTTP (for package repos)
        tcp dport 80 accept

        # Allow ICMP outbound
        ip protocol icmp accept

        # Log unusual outbound
        limit rate 5/minute log prefix "[FALCONX-OUT] " level info
    }

    # ── Forward chain ─────────────────────────────────────────────
    chain forward {
        type filter hook forward priority filter; policy drop;
        # No forwarding in MONITOR mode
    }
}

# ── Table: NAT (no rules in monitor mode) ─────────────────────────
table ip falconx_nat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
    }
}
